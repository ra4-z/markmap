{
  "name": "markmap-obsidian",
  "version": "0.1.0",
  "description": "Obsidian plugin for markmap - visualize Markdown as mindmaps",
  "main": "main.js",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "markmap",
    "mindmap"
  ],
  "author": "gera2ld",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.9",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "markmap-common": "workspace:*",
    "markmap-lib": "workspace:*",
    "markmap-toolbar": "workspace:*",
    "markmap-view": "workspace:*"
  }
}
